{
  "name": "mb-ics-reviews",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.1 || ^24.15.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/server.ts",
    "e2e": "playwright test -c ../../tests/reviews/playwright.config.ts",
    "preview": "node --experimental-strip-types scripts/prepare-preview.ts && REVIEWS_MODE=local REVIEWS_STATIC_DIR=../../.night-build/preview node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "axe-core": "4.14.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "8.10.2",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "openid-client": "6.8.8"
  }
}
