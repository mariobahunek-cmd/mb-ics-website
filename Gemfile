# mb-ics.com — lokales Jekyll-Testen
# Production läuft auf GitHub Pages, dieser Gemfile ist nur für lokales Preview.
# Installation:  gem install bundler && bundle install
# Lokales Preview: bundle exec jekyll serve

source "https://rubygems.org"

# GitHub-Pages-kompatibles Jekyll
gem "github-pages", group: :jekyll_plugins

# Plugins (in github-pages bereits enthalten, aber explizit für Klarheit)
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
end

# Ruby-Tooling für aktuelle macOS-Versionen
gem "webrick", "~> 1.8"
