---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

    {%- comment -%} Static pages — manuell gepflegt, weil sie kein Frontmatter haben.
                     lastmod auf site.time gesetzt: bei jedem Build aktualisiert. {%- endcomment -%}
    {%- assign home_variants = '/|1.0,/de/|0.9,/es/|0.9' | split: ',' %}
    {%- for hv in home_variants %}
    {%- assign hv_parts = hv | split: '|' %}
    <url>
        <loc>{{ hv_parts[0] | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>{{ hv_parts[1] }}</priority>
        <xhtml:link rel="alternate" hreflang="en" href="{{ '/' | absolute_url }}"/>
        <xhtml:link rel="alternate" hreflang="de" href="{{ '/de/' | absolute_url }}"/>
        <xhtml:link rel="alternate" hreflang="es" href="{{ '/es/' | absolute_url }}"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}"/>
    </url>
    {%- endfor %}
    <url>
        <loc>{{ '/privacy.html' | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>
    <url>
        <loc>{{ '/impressum.html' | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>
    <url>
        <loc>{{ '/sap-mm-crashcourse/' | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>{{ '/sap-mm-corporate-training/' | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ '/trainer-profile/' | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>

    {%- comment -%} Blog-Listings (per Sprache) — lastmod = newest post of that language {%- endcomment -%}
    {%- assign newest_de = site.posts | where: "lang", "de" | sort: "date" | last -%}
    {%- assign newest_en = site.posts | where: "lang", "en" | sort: "date" | last -%}
    <url>
        <loc>{{ '/blog/de/' | absolute_url }}</loc>
        {%- if newest_de %}
        <lastmod>{{ newest_de.date | date_to_xmlschema }}</lastmod>
        {%- endif %}
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
        <xhtml:link rel="alternate" hreflang="de" href="{{ '/blog/de/' | absolute_url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ '/blog/en/' | absolute_url }}"/>
    </url>
    <url>
        <loc>{{ '/blog/en/' | absolute_url }}</loc>
        {%- if newest_en %}
        <lastmod>{{ newest_en.date | date_to_xmlschema }}</lastmod>
        {%- endif %}
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
        <xhtml:link rel="alternate" hreflang="de" href="{{ '/blog/de/' | absolute_url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ '/blog/en/' | absolute_url }}"/>
    </url>

    {%- comment -%} Posts dynamisch aus _posts/ — mit Hreflang-Cross-Verlinkung {%- endcomment -%}
    {%- for post in site.posts -%}
    <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
        {%- if post.translation_key -%}
            {%- assign siblings = site.posts | where: "translation_key", post.translation_key -%}
            {%- for sib in siblings -%}
        <xhtml:link rel="alternate" hreflang="{{ sib.lang }}" href="{{ sib.url | absolute_url }}"/>
            {%- endfor -%}
        {%- endif -%}
    </url>
    {%- endfor -%}

</urlset>
